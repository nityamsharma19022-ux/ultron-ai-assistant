# =====================================================================
# ULTRON environment template
# ---------------------------------------------------------------------
# Copy to .env and set your own values:   cp .env.example .env
# .env is git-ignored and must NEVER be committed.
#
# Every variable is ULTRON_-prefixed so nothing here can be confused with
# (or silently picked up from) another project's settings.
#
# Use URL-safe passwords (letters, digits, "-" and "_") because they are
# also embedded in connection URLs.
# =====================================================================

# --- Runtime ---------------------------------------------------------
ULTRON_ENV=development
# Where this backend runs: "local" (your Windows PC) or "cloud".
ULTRON_DEPLOYMENT=local
# Name shown by /health so clients know which backend they reached.
ULTRON_NODE_ID=ultron-windows-local
ULTRON_LOG_LEVEL=INFO
# "console" (readable) or "json" (structured). Docker uses json.
ULTRON_LOG_FORMAT=console

# --- Local PostgreSQL (Docker Compose) -------------------------------
ULTRON_POSTGRES_DB=ultron
ULTRON_POSTGRES_USER=ultron
ULTRON_POSTGRES_PASSWORD=change-me-postgres
# Host port. 5433 (not 5432) avoids clashing with any other local Postgres.
ULTRON_POSTGRES_PORT=5433

# --- Local Redis (Docker Compose) ------------------------------------
ULTRON_REDIS_PASSWORD=change-me-redis
# Host port. 6380 (not 6379) avoids clashing with any other local Redis.
ULTRON_REDIS_PORT=6380

# --- Database selection ----------------------------------------------
# Exactly ONE database is used, chosen here. ULTRON never switches between
# them automatically (see docs/SYNC.md).
#   local -> ULTRON_LOCAL_DATABASE_URL (default)
#   cloud -> ULTRON_CLOUD_DATABASE_URL
ULTRON_DB_MODE=local

# Local database (used when running ULTRON Core directly on the host;
# Docker Compose builds its own internal URL from the values above).
ULTRON_LOCAL_DATABASE_URL=postgresql://ultron:change-me-postgres@localhost:5433/ultron

# Cloud database: a NEW Supabase project created only for ULTRON.
# Leave empty until it exists. Never paste another project's values here.
ULTRON_CLOUD_DATABASE_URL=
# Safety catch: migrations never run against the cloud DB unless this is
# set to true for that one command.
ULTRON_ALLOW_CLOUD_MIGRATIONS=false

# --- Redis connection ------------------------------------------------
ULTRON_REDIS_URL=redis://default:change-me-redis@localhost:6380/0
ULTRON_REDIS_KEY_PREFIX=ultron:

# --- Authentication --------------------------------------------------
# At least 32 random characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
ULTRON_JWT_SECRET=change-me-replace-with-a-long-random-string
ULTRON_ACCESS_TOKEN_TTL_SECONDS=900
ULTRON_REFRESH_TOKEN_TTL_DAYS=30
ULTRON_LOGIN_RATE_LIMIT_ATTEMPTS=10
ULTRON_LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# --- ULTRON Core API (Docker Compose) ----------------------------------
ULTRON_CORE_PORT=8000
# 127.0.0.1 = this PC only. Set to 0.0.0.0 so the Android app can reach
# this Windows backend over your home Wi-Fi (see docs/DEVELOPMENT.md).
ULTRON_CORE_BIND_HOST=127.0.0.1

# --- AI: cloud-first, local-fallback ---------------------------------------
# Cloud providers are tried in this order; any without an API key AND a
# model is skipped automatically. Users can reorder them in the app.
# Free tiers first; Anthropic (paid) last.
ULTRON_AI_CLOUD_PROVIDERS=groq,gemini,openrouter,custom,anthropic
ULTRON_AI_REQUEST_TIMEOUT_SECONDS=90
ULTRON_AI_MAX_OUTPUT_TOKENS=2048
# Development only: "cloud" or "local" adds a fake provider so the app can be
# built without any API key or model. Must be "off" in production.
ULTRON_AI_DEV_MOCK=off

# API keys stay on the server. They are never sent to the app or logged.
# Model names change often: check each provider's current model list.

# Groq (free tier) - https://console.groq.com
ULTRON_GROQ_API_KEY=
ULTRON_GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini (free tier) - https://aistudio.google.com
ULTRON_GEMINI_API_KEY=
ULTRON_GEMINI_MODEL=gemini-2.5-flash

# OpenRouter (free ":free" models available) - https://openrouter.ai
ULTRON_OPENROUTER_API_KEY=
ULTRON_OPENROUTER_MODEL=

# Any other OpenAI-compatible endpoint (optional)
ULTRON_CUSTOM_AI_BASE_URL=
ULTRON_CUSTOM_AI_API_KEY=
ULTRON_CUSTOM_AI_MODEL=

# Anthropic Claude (PAID, optional) - https://console.anthropic.com
ULTRON_ANTHROPIC_API_KEY=
ULTRON_ANTHROPIC_MODEL=claude-opus-5-5
ULTRON_ANTHROPIC_MAX_TOKENS=16000

# --- Local AI (Ollama, optional) ------------------------------------------
# Used when running ULTRON Core directly on the host, e.g.
# http://localhost:11434. Leave empty if Ollama isn't installed.
ULTRON_OLLAMA_BASE_URL=
# The local model to use. It is only reported as available when this model
# is actually installed (ollama pull llama3.2).
ULTRON_OLLAMA_MODEL=llama3.2
# Used by the Docker "core" container. Default reaches Ollama installed
# natively on the host; use http://ollama:11434 with the local-ai profile.
ULTRON_CORE_OLLAMA_BASE_URL=http://host.docker.internal:11434

# --- Chat ---------------------------------------------------------------
ULTRON_CHAT_MAX_MESSAGE_CHARS=12000
ULTRON_CHAT_RATE_LIMIT_PER_MINUTE=20

# --- Optional: ULTRON's own Supabase project (not used yet) ------------
ULTRON_SUPABASE_URL=
ULTRON_SUPABASE_PUBLISHABLE_KEY=
ULTRON_SUPABASE_SECRET_KEY=
